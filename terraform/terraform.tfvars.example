# Copy to terraform.tfvars and edit
aws_region   = "us-east-1"
project_name = "media-analytics"
environment  = "prod"

github_repo = "your-github-user/django-ecs-deploy"

# Set to false if your AWS account already has the GitHub OIDC provider
create_github_oidc_provider = true

# Optional HTTPS
# domain_name     = "dashboards.example.com"
# certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/xxxx"

# Capacity
desired_count = 2
min_capacity  = 2
max_capacity  = 10

# Cheaper settings for a demo/learning account:
# db_multi_az            = false
# db_deletion_protection = false
# secret_recovery_window_days = 0   # redeploy right after destroy
# ecr_force_delete            = true # destroy even if images exist

# alarm_email = "you@example.com"
